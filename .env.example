# Populate model-proxy credentials with:
# kaggle benchmarks auth -y --env-file .env

# Optional: override the local ViMedCSS bundle directory.
VIMEDCSS_AUDIO_BUNDLE_DIR=

# Optional: choose a specific model for the ViMedCSS benchmark.
FRONTIER_AUDIO_VIMEDCSS_MODEL=google/gemini-3.5-flash

# Optional: point at a local Meddies small-test parquet.
MEDDIES_SMALL_TEST_PARQUET_PATH=

# Optional: start with 1 for a smoke run before the full local test.
MEDDIES_SMALL_TEST_LIMIT=1

# Optional: choose a specific model for the Meddies small-test benchmark.
FRONTIER_AUDIO_MEDDIES_SMALL_TEST_MODEL=google/gemini-3.5-flash

# Optional: choose a specific model for the prompt token probe.
FRONTIER_PROMPT_TOKEN_PROBE_MODEL=google/gemini-3.5-flash

# Optional: override the embedded audio probe fixture with base64 audio.
FRONTIER_AUDIO_FIXTURE_B64=
